# Application
SECRET_KEY=replace_with_a_secure_random_secret
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
# For local development (outside Docker), use localhost:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/emporio_platform
# Docker Compose overrides DATABASE_URL automatically to use the 'db' service hostname.

# PostgreSQL (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=emporio_platform

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_llm_model
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Authentication
SESSION_COOKIE_NAME=emporio_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_DAYS=7

# Document Processing
MAX_UPLOAD_SIZE_MB=10
